{
    "openapi": "3.2.0",
    "info": {
        "title": "Books",
        "version": "0.6.0"
    },
    "paths": {
        "/books": {
            "get": {
                "tags": [
                    "books"
                ],
                "summary": "List books",
                "operationId": "Books.list",
                "parameters": [
                    {
                        "name": "page",
                        "in": "query",
                        "schema": {
                            "type": "integer",
                            "format": "int32",
                            "default": 1
                        }
                    },
                    {
                        "name": "authorId",
                        "in": "query",
                        "style": "form",
                        "explode": true,
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/components/schemas/AuthorId"
                            }
                        }
                    },
                    {
                        "name": "X-Request-Id",
                        "in": "header",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "format": "uuid"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/components/schemas/Book"
                                    }
                                }
                            }
                        }
                    }
                }
            },
            "post": {
                "tags": [
                    "books"
                ],
                "summary": "Create a book",
                "operationId": "Books.create",
                "parameters": [
                    {
                        "name": "X-Request-Id",
                        "in": "header",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "format": "uuid"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/CreateBook"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Created",
                        "headers": {
                            "Location": {
                                "required": true,
                                "schema": {
                                    "type": "string"
                                }
                            }
                        },
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Book"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Bad Request"
                    }
                }
            }
        },
        "/books/{bookId}": {
            "get": {
                "tags": [
                    "books"
                ],
                "summary": "Get a book",
                "operationId": "Books.get",
                "parameters": [
                    {
                        "name": "bookId",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "$ref": "#/components/schemas/BookId"
                        }
                    },
                    {
                        "name": "X-Request-Id",
                        "in": "header",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "format": "uuid"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Book"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Not Found"
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "AuthorId": {
                "type": "string"
            },
            "BookId": {
                "type": "string"
            },
            "Author": {
                "type": "object",
                "properties": {
                    "id": {
                        "$ref": "#/components/schemas/AuthorId"
                    },
                    "name": {
                        "type": "string"
                    }
                },
                "required": [
                    "id",
                    "name"
                ]
            },
            "Book": {
                "type": "object",
                "properties": {
                    "id": {
                        "$ref": "#/components/schemas/BookId"
                    },
                    "title": {
                        "type": "string"
                    },
                    "authors": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/Author"
                        }
                    }
                },
                "required": [
                    "id",
                    "title",
                    "authors"
                ]
            },
            "CreateBook": {
                "type": "object",
                "properties": {
                    "title": {
                        "type": "string"
                    },
                    "authorIds": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/AuthorId"
                        }
                    }
                },
                "required": [
                    "title",
                    "authorIds"
                ]
            }
        }
    }
}
