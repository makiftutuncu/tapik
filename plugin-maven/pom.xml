<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.akif</groupId>
        <artifactId>tapik-parent</artifactId>
        <version>0.6.0</version>
    </parent>

    <artifactId>tapik-plugin-maven</artifactId>
    <packaging>maven-plugin</packaging>
    <name>tapik Maven Plugin</name>

    <properties>
        <release.artifacts.skip>false</release.artifacts.skip>
    </properties>

    <dependencies>
        <dependency>
            <groupId>dev.akif</groupId>
            <artifactId>tapik-plugin-compiler</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>dev.akif</groupId>
            <artifactId>tapik-common-plugin</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>dev.akif</groupId>
            <artifactId>tapik-target-openapi</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>dev.akif</groupId>
            <artifactId>tapik-target-spring-restclient</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>dev.akif</groupId>
            <artifactId>tapik-target-spring-webmvc</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.maven</groupId>
            <artifactId>maven-plugin-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.maven</groupId>
            <artifactId>maven-core</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.maven.plugin-tools</groupId>
            <artifactId>maven-plugin-annotations</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.jetbrains.kotlin</groupId>
            <artifactId>kotlin-maven-plugin</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.jetbrains.kotlin</groupId>
            <artifactId>kotlin-compiler-embeddable</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.akif</groupId>
            <artifactId>tapik-test-fixtures</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.kotest</groupId>
            <artifactId>kotest-runner-junit5-jvm</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.kotest</groupId>
            <artifactId>kotest-assertions-core-jvm</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.jetbrains.kotlin</groupId>
                <artifactId>kotlin-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-plugin-plugin</artifactId>
                <configuration>
                    <goalPrefix>tapik</goalPrefix>
                </configuration>
                <executions>
                    <execution>
                        <id>generate-help</id>
                        <goals>
                            <goal>helpmojo</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
