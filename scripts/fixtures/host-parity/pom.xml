<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>dev.akif.tapik.testing</groupId>
    <artifactId>host-parity-maven</artifactId>
    <version>1</version>

    <properties>
        <tapik.version>0.6.0</tapik.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>dev.akif</groupId>
            <artifactId>tapik-example-contract</artifactId>
            <version>${tapik.version}</version>
        </dependency>
    </dependencies>

    <build>
        <directory>${project.basedir}/build/maven</directory>
        <plugins>
            <plugin>
                <groupId>dev.akif</groupId>
                <artifactId>tapik-plugin-maven</artifactId>
                <version>${tapik.version}</version>
                <executions>
                    <execution>
                        <id>openapi-default</id>
                        <phase>generate-sources</phase>
                        <goals><goal>generate</goal></goals>
                        <configuration>
                            <target>openapi</target>
                            <outputDirectory>${project.build.directory}/raw/documentation</outputDirectory>
                            <targetConfiguration>
                                <version>${tapik.version}</version>
                            </targetConfiguration>
                        </configuration>
                    </execution>
                    <execution>
                        <id>openapi-explicit</id>
                        <phase>generate-sources</phase>
                        <goals><goal>generate</goal></goals>
                        <configuration>
                            <target>openapi</target>
                            <outputDirectory>${project.build.directory}/raw/documentation</outputDirectory>
                            <targetConfiguration>
                                <version>${tapik.version}-explicit</version>
                                <format>json</format>
                                <pretty>false</pretty>
                                <componentNaming>qualified</componentNaming>
                                <output>explicit/{api}.json</output>
                            </targetConfiguration>
                        </configuration>
                    </execution>
                    <execution>
                        <id>restclient-default</id>
                        <phase>generate-sources</phase>
                        <goals><goal>generate</goal></goals>
                        <configuration>
                            <target>spring-restclient</target>
                            <outputDirectory>${project.build.directory}/raw/spring</outputDirectory>
                        </configuration>
                    </execution>
                    <execution>
                        <id>restclient-explicit</id>
                        <phase>generate-sources</phase>
                        <goals><goal>generate</goal></goals>
                        <configuration>
                            <target>spring-restclient</target>
                            <outputDirectory>${project.build.directory}/raw/spring</outputDirectory>
                            <targetConfiguration>
                                <packageName>com.example.parity</packageName>
                                <clientSuffix>HttpClient</clientSuffix>
                            </targetConfiguration>
                        </configuration>
                    </execution>
                    <execution>
                        <id>webmvc-default</id>
                        <phase>generate-sources</phase>
                        <goals><goal>generate</goal></goals>
                        <configuration>
                            <target>spring-webmvc</target>
                            <outputDirectory>${project.build.directory}/raw/spring</outputDirectory>
                        </configuration>
                    </execution>
                    <execution>
                        <id>webmvc-explicit</id>
                        <phase>generate-sources</phase>
                        <goals><goal>generate</goal></goals>
                        <configuration>
                            <target>spring-webmvc</target>
                            <outputDirectory>${project.build.directory}/raw/spring</outputDirectory>
                            <targetConfiguration>
                                <packageName>com.example.parity</packageName>
                                <serverSuffix>HttpServer</serverSuffix>
                                <controllerSuffix>Controller</controllerSuffix>
                            </targetConfiguration>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
